# Image and host ports
APP_VERSION=v8.6.3
APP_PORT=8090
DB_HOST_PORT=13307

# Automation account created during the Snipe-IT setup wizard
SNIPEIT_BASE_URL=http://localhost:8090
SNIPEIT_ADMIN_USERNAME=admin
SNIPEIT_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
SNIPEIT_ADMIN_EMAIL=automation@example.test
SNIPEIT_API_TOKEN=REPLACE_WITH_PERSONAL_ACCESS_TOKEN
SNIPEIT_BROWSER=edge
SNIPEIT_DRIVER_PATH=
SNIPEIT_HEADLESS=true
SNIPEIT_UI_TIMEOUT=10

# Application
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_A_GENERATED_32_BYTE_KEY
APP_URL=http://localhost:8090
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh-CN
MAX_RESULTS=500
API_THROTTLE_PER_MINUTE=1000
PRIVATE_FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=local_public

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_SOCKET=null
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
DB_PREFIX=null
DB_DUMP_PATH=/usr/bin
DB_DUMP_SKIP_SSL=true
DB_DUMP_SINGLE_TRANSACTION=false
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SSL=false

# Local test environment: write outgoing mail to the application log
MAIL_MAILER=log
MAIL_FROM_ADDR=automation@example.test
MAIL_FROM_NAME=Snipe-IT-Automation
MAIL_REPLYTO_ADDR=automation@example.test
MAIL_REPLYTO_NAME=Snipe-IT-Automation

# Storage, session and queue
ALLOW_BACKUP_DELETE=false
ALLOW_DATA_PURGE=false
IMAGE_LIB=gd
SESSION_LIFETIME=1200
EXPIRE_ON_CLOSE=false
ENCRYPT=false
COOKIE_NAME=snipeit_session
COOKIE_DOMAIN=null
SECURE_COOKIES=false
API_TOKEN_EXPIRATION_YEARS=1
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_PREFIX=snipeit_automation

# Local-only security and logging
APP_TRUSTED_PROXIES=REMOTE_ADDR
ALLOW_IFRAMING=false
REFERRER_POLICY=same-origin
ENABLE_CSP=false
ENABLE_HSTS=false
LOGIN_MAX_ATTEMPTS=20
LOGIN_LOCKOUT_DURATION=30
LOG_CHANNEL=stderr
LOG_MAX_DAYS=10
APP_LOCKED=false
APP_CIPHER=AES-256-CBC
APP_FORCE_TLS=false
